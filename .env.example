# Required
OPENAI_API_KEY=sk-your-openai-api-key

# Optional — weather forecasts (planner skips weather if unset)
OPENWEATHER_API_KEY=

# Recommended — required by Nominatim and Wikipedia API etiquette
NOMINATIM_USER_AGENT=RoadtripPlanner/1.0 (you@example.com)

# Optional — LangSmith agent tracing
LANGSMITH_API_KEY=
LANGSMITH_TRACING=true
LANGSMITH_PROJECT=Roadtrip_Planner

# Optional — plan start caps, counted in memory for this process.
# A failed feasibility check still counts. Polling a job does not.
# More than one server process needs a shared store, or each process keeps its own budget.
# PLAN_DAILY_LIMIT_PER_IP=3
# PLAN_DAILY_LIMIT_GLOBAL=30
# PLAN_MAX_CONCURRENT_JOBS=2
# PLAN_RATE_WINDOW_SECONDS=86400
# Set true only behind a proxy that overwrites X-Forwarded-For with the visitor address.
# TRUST_X_FORWARDED_FOR=false

# Optional — defaults shown below (uncomment to override)
# OPENAI_MODEL=gpt-4o-mini
# OSRM_BASE_URL=https://router.project-osrm.org
# NOMINATIM_BASE_URL=https://nominatim.openstreetmap.org
# WIKIPEDIA_API_URL=https://en.wikipedia.org/w/api.php
# OVERPASS_API_URL=https://overpass-api.de/api/interpreter
# OPENWEATHER_BASE_URL=https://api.openweathermap.org/data/2.5
